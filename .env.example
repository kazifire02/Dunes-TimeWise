# Local Flask / migration scripts. Cloudflare production uses HYPERDRIVE instead.
# Set LATETRACK_SECRET_KEY as a Cloudflare runtime secret too.
# This file is not automatically loaded by Flask.
DATABASE_URL=postgresql://USER:NEW_PASSWORD@DIRECT_HOST/neondb?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://USER:NEW_PASSWORD@POOLED_HOST/neondb?sslmode=require&channel_binding=require
LATETRACK_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
