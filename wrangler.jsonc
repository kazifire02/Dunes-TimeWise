{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dunes-timewise",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["python_workers"],
  // Set DATABASE_URL_POOLED and LATETRACK_SECRET_KEY in the Worker dashboard.
  // Keep credentials out of this file and preserve dashboard variables on deploy.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "build": {
    "command": "uv run python scripts/build_worker.py && uv run pywrangler sync --force && uv run python scripts/verify_worker_packages.py"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
