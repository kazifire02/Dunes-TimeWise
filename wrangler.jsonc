{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dunes-timewise",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["python_workers"],
  // Create a Hyperdrive configuration for Neon, then uncomment this line
  // and replace the placeholder with its configuration ID (not a password):
  // "hyperdrive": [{"binding": "HYPERDRIVE", "id": "YOUR_HYPERDRIVE_ID"}],
  "build": {
    "command": "uv run python scripts/build_worker.py && uv run pywrangler sync --force && uv run python scripts/verify_worker_packages.py"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
